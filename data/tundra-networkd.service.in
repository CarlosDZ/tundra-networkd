[Unit]
Description=Tundra network orchestrator
Documentation=https://github.com/CarlosDZ/tundra-networkd
Wants=network.target
Before=network.target

[Service]
Type=simple
ExecStart=@BINDIR@/tundra-networkd
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
