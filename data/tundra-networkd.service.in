[Unit]
Description=Tundra network orchestrator
Documentation=https://github.com/CarlosDZ/tundra-networkd
Wants=network.target
Before=network.target

[Service]
Type=simple
ExecStart=@BINDIR@/tundra-networkd
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=1

# ADR-031. The daemon keeps these only as inheritable, for the children that
# carry the matching file capability. No NoNewPrivileges and nothing of the
# seccomp family: they would void those file capabilities.
User=tundra-network
Group=tundra-network
SupplementaryGroups=network
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
RuntimeDirectory=tundra
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes

# No UMask: /run/tundra/network holds resolv.conf and has to stay readable;
# every file the daemon writes sets its own mode.
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=yes
DevicePolicy=closed
DeviceAllow=/dev/rfkill r
TasksMax=64

[Install]
WantedBy=multi-user.target
